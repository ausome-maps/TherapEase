# ── Django ──────────────────────────────────────────────────────────
DEBUG=1
DJANGO_SECRET_KEY=thisisaverysecretkey-change-in-prod

# ── Database (PostgreSQL) ───────────────────────────────────────────
POSTGRES_USER=therapease_user_dev
POSTGRES_PASSWORD=therapease_devpass
POSTGRES_DB=therapease_db_dev
POSTGRES_HOST=therapease_db
POSTGRES_PORT=5432

# ── Redis / Celery ──────────────────────────────────────────────────
REDIS_URL=redis://therapease_cache:6379
REDIS_CACHED=redis://therapease_cache:6379
CELERY_BROKER_URL=redis://therapease_cache:6379/0
CELERY_RESULT_BACKEND=redis://therapease_cache:6379/0

# ── MinIO (S3-compatible storage) ───────────────────────────────────
MINIO_ROOT_USER=therapease-minio
MINIO_ROOT_PASSWORD=therapease-object-password
MINIO_ACCESS_KEY=therapease-minio
MINIO_SECRET_KEY=therapease-object-password
MINIO_ENDPOINT=therapease_storage:9000
MINIO_SECURE=0
MINIO_BUCKET=submissions

# ── Email ───────────────────────────────────────────────────────────
# DEV_EMAIL=1  → real emails via Brevo API.  DEV_EMAIL=0 → console only.
# EMAIL_SEND=1 → enable all outgoing email.  EMAIL_SEND=0 → suppress all.
DEV_EMAIL=1
EMAIL_SEND=1
BREVO_API_KEY=xkeysib-your-brevo-api-key
DEFAULT_FROM_EMAIL="admin@sample.com"
ADMIN_EMAIL="admin@sample.com"

# ── Domains / URLs ──────────────────────────────────────────────────
API_DOMAIN_NAME=localhost:9001
UI_DOMAIN_NAME=localhost:9002
TRUSTED_DOMAINS=http://127.0.0.1,http://localhost:9002
GEOCODE_URL=https://nominatim.openstreetmap.org/search

# ── Frontend (Nuxt) ─────────────────────────────────────────────────
NUXT_PUBLIC_API_URL=http://localhost:9001
NUXT_PUBLIC_UI_URL=http://localhost:9002
NUXT_PUBLIC_COPYRIGHT_YEAR=2026
NUXT_PUBLIC_FEEDBACK_URL=https://forms.gle/Yo4zMgBXXfAL7vyS6
NUXT_PUBLIC_AUTH_ENABLED=1
NUXT_PUBLIC_REGISTRATION_ENABLED=0
GOOGLE_TAG_MANAGER=https://www.googletagmanager.com/gtag/js?id=G-E1HY2D8NC8

# ── Features ────────────────────────────────────────────────────────
FEATURE_AUTH_ENABLED=1
FEATURE_REGISTRATION_ENABLED=0
